generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
}

model Department {
  id    Int    @id @default(autoincrement())
  name  String
  rooms Room[]
  users User[]
}

model Room {
  id                     Int                         @id @default(autoincrement())
  name                   String
  location               String
  departmentId           Int
  apparatusBorrowRecords ApparatusBorrowRecord[]
  borrowRecords          BorrowRecord[]
  chemicalAssignments    ChemicalAssignment[]
  chemicalUsages         ChemicalUsage[]
  chemicalUsageRecords   ChemicalUsageRecord[]
  distributionRecords    DistributionRecord[]
  equipmentAssignments   EquipmentAssignmentRecord[]
  equipmentBorrowRecords EquipmentBorrowRecord[]
  labBorrowRecords       LabBorrowRecord[]
  department             Department                  @relation(fields: [departmentId], references: [id])
  transferRequests       TransferRequest[]
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  userRoles UserRole[]
}

model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model User {
  id                     Int                         @id @default(autoincrement())
  username               String                      @unique
  email                  String                      @unique
  passwordHash           String
  firstName              String?
  lastName               String?
  contactNumber          String?
  customId               Int?                        @unique
  barcodeValue           String?                     @unique
  barcodeImageUrl        String?
  profilePicUrl          String?
  isActive               Boolean                     @default(true)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  departmentId           Int?
  appBatchesAdded        ApparatusBatch[]            @relation("AppBatchAddedBy")
  apparatusBorrows       ApparatusBorrowRecord[]     @relation("AppBorrowBorrower")
  currentlyBorrowedItems BorrowRecord[]              @relation("BorrowRecordBorrower")
  previousBorrows        BorrowRecord[]              @relation("PreviousBorrower")
  receivedChemicals      ChemicalAssignment[]        @relation("ChemAssignAssignee")
  processedChemicals     ChemicalAssignment[]        @relation("ChemAssignProcessed")
  chemBatchesAdded       ChemicalBatch[]             @relation("ChemBatchAddedBy")
  chemicalUsages         ChemicalUsage[]             @relation("ChemUsageBorrower")
  chemRecorded           ChemicalUsageRecord[]       @relation("ChemRecordedBy")
  chemUsages             ChemicalUsageRecord[]       @relation("ChemUsedBy")
  batchesAdded           ConsumableBatch[]           @relation("BatchAddedBy")
  disposeRequests        DisposeRequest[]            @relation("DisposeRequestedBy")
  processedDisposals     DisposeRequest[]            @relation("DisposeProcessedBy")
  receivedItems          DistributionRecord[]        @relation("ReceivedItems")
  distributedItems       DistributionRecord[]        @relation("DistributedItems")
  equipmentAssignments   EquipmentAssignmentRecord[] @relation("EqAssignAssignee")
  equipmentBorrows       EquipmentBorrowRecord[]     @relation("EqBorrowBorrower")
  labPrevBorrows         LabBorrowRecord[]           @relation("LabPrevBorrower")
  labBorrowRecords       LabBorrowRecord[]           @relation("LabBorrowedBy")
  replaceRequests        ReplaceRequest[]            @relation("ReplaceRequestedBy")
  processedReplaces      ReplaceRequest[]            @relation("ReplaceProcessedBy")
  transferRequests       TransferRequest[]           @relation("TransferRequestedBy")
  newTransferAssignments TransferRequest[]           @relation("TransferNewAssignee")
  processedTransfers     TransferRequest[]           @relation("TransferProcessedBy")
  department             Department?                 @relation(fields: [departmentId], references: [id])
  roles                  UserRole[]
}

model Category {
  id       Int     @id @default(autoincrement())
  name     String
  imageUrl String?
  items    Item[]
}

model Item {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  model       String?
  itemType    String         @default("Non-Consumables")
  quantity    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  categoryId  Int?
  deletedAt   DateTime?
  category    Category?      @relation(fields: [categoryId], references: [id])
  instances   ItemInstance[]
}

model ItemInstance {
  id                  Int                  @id @default(autoincrement())
  unitCost            Float                @default(0)
  quantity            Int                  @default(0)
  purchaseDate        DateTime?
  serialNumber        String?              @unique
  inventoryNumber     String?              @unique
  currentCondition    String?              @default("Good")
  lastCondition       String?
  barcodeUrl          String?
  usefulLife          Int?
  itemId              Int
  borrowRecords       BorrowRecord[]
  consumableBatches   ConsumableBatch[]
  disposeRequests     DisposeRequest[]
  distributionRecords DistributionRecord[]
  item                Item                 @relation(fields: [itemId], references: [id])
  replaceRequests     ReplaceRequest[]     @relation("ItemReplacementInstance")
  replaceForRequests  ReplaceRequest[]     @relation("ItemReplacementFor")
  transferRequests    TransferRequest[]
}

model BorrowRecord {
  id             Int           @id @default(autoincrement())
  quantity       Int           @default(0)
  customBorrower String?
  borrowDate     DateTime      @default(now())
  duration       Int?
  returnDate     DateTime?
  purpose        String?
  itemInstanceId Int
  borrowerId     Int?
  roomId         Int?
  previousUserId Int?
  itemInstance   ItemInstance  @relation(fields: [itemInstanceId], references: [id])
  borrower       User?         @relation("BorrowRecordBorrower", fields: [borrowerId], references: [id])
  room           Room?         @relation(fields: [roomId], references: [id])
  previousUser   User?         @relation("PreviousBorrower", fields: [previousUserId], references: [id])
  returnRecord   ReturnRecord?
}

model ReturnRecord {
  id                Int          @id @default(autoincrement())
  returnDate        DateTime     @default(now())
  conditionOnReturn String?
  notes             String?
  borrowRecordId    Int          @unique
  itemInstanceId    Int
  borrowRecord      BorrowRecord @relation(fields: [borrowRecordId], references: [id])
}

model DistributionRecord {
  id              Int              @id @default(autoincrement())
  itemInstanceId  Int
  recipientId     Int
  distributedById Int
  roomId          Int?
  quantity        Int              @default(1)
  purpose         String?
  distributedAt   DateTime         @default(now())
  batchId         Int?
  batch           ConsumableBatch? @relation(fields: [batchId], references: [id])
  itemInstance    ItemInstance     @relation(fields: [itemInstanceId], references: [id])
  recipient       User             @relation("ReceivedItems", fields: [recipientId], references: [id])
  distributedBy   User             @relation("DistributedItems", fields: [distributedById], references: [id])
  room            Room?            @relation(fields: [roomId], references: [id])
}

model ConsumableBatch {
  id                  Int                  @id @default(autoincrement())
  itemInstanceId      Int
  batchNumber         String
  originalQty         Int
  remainingQty        Int
  unitCost            Float                @default(0)
  purchaseDate        DateTime?
  notes               String?
  addedById           Int
  addedAt             DateTime             @default(now())
  addedBy             User                 @relation("BatchAddedBy", fields: [addedById], references: [id])
  itemInstance        ItemInstance         @relation(fields: [itemInstanceId], references: [id], onDelete: Cascade)
  distributionRecords DistributionRecord[]
}

model Unit {
  id     Int    @id @default(autoincrement())
  name   String
  symbol String
}

model LabCategory {
  id         Int         @id @default(autoincrement())
  name       String
  imageUrl   String?
  apparatus  Apparatus[]
  equipments Equipment[]
}

model Subject {
  id                   Int                     @id @default(autoincrement())
  name                 String
  code                 String                  @unique
  apparatusBorrows     ApparatusBorrowRecord[]
  chemicalUsages       ChemicalUsage[]
  chemicalUsageRecords ChemicalUsageRecord[]
  equipmentBorrows     EquipmentBorrowRecord[]
}

model Equipment {
  id          Int                 @id @default(autoincrement())
  name        String
  model       String?
  description String?
  quantity    Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  categoryId  Int?
  deletedAt   DateTime?
  category    LabCategory?        @relation(fields: [categoryId], references: [id])
  instances   EquipmentInstance[]
}

model EquipmentInstance {
  id               Int                         @id @default(autoincrement())
  quantity         Int                         @default(0)
  unitCost         Float                       @default(0)
  inventoryNumber  String                      @unique
  usefulLife       Int?
  purchaseDate     DateTime?
  serialNumber     String?                     @unique
  status           String                      @default("Inactive")
  currentCondition String?                     @default("Good")
  lastCondition    String?
  barcodeUrl       String?
  deletedAt        DateTime?
  equipmentId      Int
  assignments      EquipmentAssignmentRecord[]
  borrowRecords    EquipmentBorrowRecord[]
  equipment        Equipment                   @relation(fields: [equipmentId], references: [id])
  returnRecords    EquipmentReturnRecord[]
  labBorrowRecords LabBorrowRecord[]
}

model EquipmentAssignmentRecord {
  id                  Int               @id @default(autoincrement())
  inventoryNumber     String            @unique
  quantity            Int               @default(0)
  assignedDate        DateTime?
  unassignedDate      DateTime?
  equipmentInstanceId Int
  assigneeId          Int?
  assignedLocationId  Int?
  equipmentInstance   EquipmentInstance @relation(fields: [equipmentInstanceId], references: [id])
  assignee            User?             @relation("EqAssignAssignee", fields: [assigneeId], references: [id])
  assignedLocation    Room?             @relation(fields: [assignedLocationId], references: [id])
}

model EquipmentBorrowRecord {
  id                  Int                     @id @default(autoincrement())
  quantity            Int                     @default(0)
  customBorrower      String?
  borrowedDate        DateTime?
  returnedDate        DateTime?
  purpose             String?
  equipmentInstanceId Int
  borrowerId          Int?
  subjectId           Int?
  roomId              Int?
  equipmentInstance   EquipmentInstance       @relation(fields: [equipmentInstanceId], references: [id])
  borrower            User?                   @relation("EqBorrowBorrower", fields: [borrowerId], references: [id])
  subject             Subject?                @relation(fields: [subjectId], references: [id])
  room                Room?                   @relation(fields: [roomId], references: [id])
  returnRecords       EquipmentReturnRecord[]
}

model EquipmentReturnRecord {
  id                  Int                   @id @default(autoincrement())
  returnedDate        DateTime?
  remarks             String?
  equipmentInstanceId Int
  borrowRecordId      Int
  equipmentInstance   EquipmentInstance     @relation(fields: [equipmentInstanceId], references: [id])
  borrowRecord        EquipmentBorrowRecord @relation(fields: [borrowRecordId], references: [id])
}

model Apparatus {
  id            Int                 @id @default(autoincrement())
  name          String
  apparatusType String              @default("Non-Consumables")
  description   String?
  quantity      Int                 @default(0)
  deletedAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  categoryId    Int?
  category      LabCategory?        @relation(fields: [categoryId], references: [id])
  batches       ApparatusBatch[]
  instances     ApparatusInstance[]
}

model ApparatusInstance {
  id               Int                     @id @default(autoincrement())
  serialNumber     String?                 @unique
  inventoryNumber  String                  @unique
  unitCost         Float                   @default(0)
  quantity         Int                     @default(0)
  currentCondition String?                 @default("Good")
  lastCondition    String?
  barcodeUrl       String?
  purchaseDate     DateTime?
  usefulLife       Int?
  deletedAt        DateTime?
  apparatusId      Int
  borrowRecords    ApparatusBorrowRecord[]
  apparatus        Apparatus               @relation(fields: [apparatusId], references: [id])
  returnRecords    ApparatusReturnRecord[]
  labBorrowRecords LabBorrowRecord[]
}

model ApparatusBorrowRecord {
  id                  Int                     @id @default(autoincrement())
  quantity            Int                     @default(0)
  customBorrower      String?
  borrowedDate        DateTime                @default(now())
  returnedDate        DateTime?
  purpose             String?
  apparatusInstanceId Int
  borrowerId          Int
  roomId              Int?
  subjectId           Int?
  apparatusInstance   ApparatusInstance       @relation(fields: [apparatusInstanceId], references: [id])
  borrower            User                    @relation("AppBorrowBorrower", fields: [borrowerId], references: [id])
  room                Room?                   @relation(fields: [roomId], references: [id])
  subject             Subject?                @relation(fields: [subjectId], references: [id])
  returnRecords       ApparatusReturnRecord[]
}

model ApparatusReturnRecord {
  id                  Int                   @id @default(autoincrement())
  returnedDate        DateTime              @default(now()) @updatedAt
  remarks             String?
  apparatusInstanceId Int
  borrowRecordId      Int
  apparatusInstance   ApparatusInstance     @relation(fields: [apparatusInstanceId], references: [id])
  borrowRecord        ApparatusBorrowRecord @relation(fields: [borrowRecordId], references: [id])
}

model ChemicalStock {
  id                  Int                  @id @default(autoincrement())
  price               Float                @default(0)
  purchaseDate        DateTime?
  inventoryNumber     String               @unique
  volume              Float                @default(0)
  expiryDate          DateTime?
  barcodeUrl          String?
  chemicalId          Int
  chemicalAssignments ChemicalAssignment[]
  chemical            OldChemical          @relation(fields: [chemicalId], references: [id])
  chemicalUsages      ChemicalUsage[]
}

model OldChemical {
  id           Int             @id @default(autoincrement())
  name         String
  unit         String?
  description  String?
  volume       Float           @default(0)
  reorderLevel Float           @default(0)
  stocks       ChemicalStock[]
}

model ChemicalUsage {
  id                  Int           @id @default(autoincrement())
  quantityUsed        Float         @default(0)
  quantityRequested   Float?
  requestUnit         String?
  purpose             String?
  dateUsed            DateTime      @default(now())
  requestedChemicalId Int
  borrowerId          Int
  subjectId           Int?
  roomId              Int?
  requestedChemical   ChemicalStock @relation(fields: [requestedChemicalId], references: [id])
  borrower            User          @relation("ChemUsageBorrower", fields: [borrowerId], references: [id])
  subject             Subject?      @relation(fields: [subjectId], references: [id])
  room                Room?         @relation(fields: [roomId], references: [id])
}

model ChemicalAssignment {
  id              Int           @id @default(autoincrement())
  assignedVolume  Float
  remainingVolume Float
  processedDate   DateTime?
  assigneeId      Int
  roomId          Int?
  chemicalStockId Int
  processedById   Int?
  assignee        User          @relation("ChemAssignAssignee", fields: [assigneeId], references: [id])
  room            Room?         @relation(fields: [roomId], references: [id])
  chemicalStock   ChemicalStock @relation(fields: [chemicalStockId], references: [id])
  processedBy     User?         @relation("ChemAssignProcessed", fields: [processedById], references: [id])
}

model TransferRequest {
  id             Int          @id @default(autoincrement())
  requestedDate  DateTime     @default(now())
  transferReason String?
  processedDate  DateTime?
  status         String       @default("PENDING")
  itemInstanceId Int
  requestedById  Int
  newAssigneeId  Int
  newLocationId  Int
  processedById  Int?
  itemInstance   ItemInstance @relation(fields: [itemInstanceId], references: [id])
  requestedBy    User         @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  newAssignee    User         @relation("TransferNewAssignee", fields: [newAssigneeId], references: [id])
  newLocation    Room         @relation(fields: [newLocationId], references: [id])
  processedBy    User?        @relation("TransferProcessedBy", fields: [processedById], references: [id])
}

model ReplaceRequest {
  id                Int           @id @default(autoincrement())
  requestedDate     DateTime      @default(now())
  replacementReason String?
  processedDate     DateTime?
  status            String        @default("PENDING")
  itemInstanceId    Int
  requestedById     Int
  replacementItemId Int?
  processedById     Int?
  itemInstance      ItemInstance  @relation("ItemReplacementInstance", fields: [itemInstanceId], references: [id])
  requestedBy       User          @relation("ReplaceRequestedBy", fields: [requestedById], references: [id])
  replacementItem   ItemInstance? @relation("ItemReplacementFor", fields: [replacementItemId], references: [id])
  processedBy       User?         @relation("ReplaceProcessedBy", fields: [processedById], references: [id])
}

model DisposeRequest {
  id             Int          @id @default(autoincrement())
  requestedDate  DateTime     @default(now())
  disposalReason String?
  processedDate  DateTime?
  status         String       @default("PENDING")
  itemInstanceId Int
  requestedById  Int
  processedById  Int?
  itemInstance   ItemInstance @relation(fields: [itemInstanceId], references: [id])
  requestedBy    User         @relation("DisposeRequestedBy", fields: [requestedById], references: [id])
  processedBy    User?        @relation("DisposeProcessedBy", fields: [processedById], references: [id])
}

model ApparatusBatch {
  id           Int       @id @default(autoincrement())
  apparatusId  Int
  batchNumber  String
  originalQty  Int
  remainingQty Int
  unitCost     Float     @default(0)
  purchaseDate DateTime?
  notes        String?
  addedById    Int
  addedAt      DateTime  @default(now())
  addedBy      User      @relation("AppBatchAddedBy", fields: [addedById], references: [id])
  apparatus    Apparatus @relation(fields: [apparatusId], references: [id])
}

model Chemical {
  id           Int             @id @default(autoincrement())
  name         String          @unique
  unit         String?
  description  String?
  volume       Float           @default(0)
  reorderLevel Float           @default(0)
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  batches      ChemicalBatch[]
}

model ChemicalBatch {
  id              Int                   @id @default(autoincrement())
  chemicalId      Int
  batchNumber     String
  originalVolume  Float                 @default(0)
  remainingVolume Float                 @default(0)
  unitCost        Float                 @default(0)
  purchaseDate    DateTime?
  expiryDate      DateTime?
  inventoryNumber String                @unique
  notes           String?
  addedById       Int
  addedAt         DateTime              @default(now())
  addedBy         User                  @relation("ChemBatchAddedBy", fields: [addedById], references: [id])
  chemical        Chemical              @relation(fields: [chemicalId], references: [id])
  usages          ChemicalUsageRecord[]
}

model ChemicalUsageRecord {
  id                Int           @id @default(autoincrement())
  chemicalBatchId   Int
  usedById          Int?
  subjectId         Int?
  roomId            Int?
  quantityUsed      Float
  quantityRequested Float
  unit              String?
  purpose           String?
  dateUsed          DateTime      @default(now())
  recordedById      Int
  recordedBy        User          @relation("ChemRecordedBy", fields: [recordedById], references: [id])
  room              Room?         @relation(fields: [roomId], references: [id])
  subject           Subject?      @relation(fields: [subjectId], references: [id])
  usedBy            User?         @relation("ChemUsedBy", fields: [usedById], references: [id])
  chemicalBatch     ChemicalBatch @relation(fields: [chemicalBatchId], references: [id])
}

model LabBorrowRecord {
  id                  Int                @id @default(autoincrement())
  equipmentInstanceId Int?
  apparatusInstanceId Int?
  borrowerId          Int?
  studentName         String?
  studentCourse       String?
  studentYearLevel    String?
  roomId              Int?
  purpose             String?
  borrowDate          DateTime           @default(now())
  dueDate             DateTime?
  returnDate          DateTime?
  previousBorrowerId  Int?
  previousBorrower    User?              @relation("LabPrevBorrower", fields: [previousBorrowerId], references: [id])
  room                Room?              @relation(fields: [roomId], references: [id])
  borrower            User?              @relation("LabBorrowedBy", fields: [borrowerId], references: [id])
  apparatusInstance   ApparatusInstance? @relation(fields: [apparatusInstanceId], references: [id])
  equipmentInstance   EquipmentInstance? @relation(fields: [equipmentInstanceId], references: [id])
  returnRecord        LabReturnRecord?
}

model LabReturnRecord {
  id                Int             @id @default(autoincrement())
  labBorrowRecordId Int             @unique
  returnDate        DateTime        @default(now())
  conditionOnReturn String?
  notes             String?
  labBorrowRecord   LabBorrowRecord @relation(fields: [labBorrowRecordId], references: [id])
}
